{
  "name": "school-voting-desktop",
  "version": "1.0.0",
  "description": "Desktop client for the School Voting API (Electron + React).",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5174 && cross-env NODE_ENV=development electron .\"",
